{
  "installCommand": "npm ci --force",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/work/:slug*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/world",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/world/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
